# Chaves do EmailJS (https://www.emailjs.com/) — opcional.
# Sem elas, o formulário de contato abre o cliente de e-mail do visitante (mailto:).
VITE_SERVICE_ID=
VITE_TEMPLATE_ID=
VITE_PUBLIC_KEY=

# Chave da GNews (https://gnews.io/) para as notícias do Blog.
# Sem prefixo VITE_ de propósito: é lida só no servidor (/api/news) e nunca vai para o bundle.
# Na Vercel, cadastre em Settings → Environment Variables.
GNEWS_API_KEY=
